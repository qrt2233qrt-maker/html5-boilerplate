# Copy to .env (never commit the real one) or set these in your host's settings.

NODE_ENV=production
PORT=3000
APP_URL=https://work.example.com
DATABASE_URL=postgres://workforce:CHANGE_ME@db.example.com:5432/workforce

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes saved two-step verification secrets unreadable.
APP_ENCRYPTION_KEY=

# Set when the app runs behind a load balancer or proxy, so rate limits see real client IPs.
TRUST_PROXY=true

# Let new businesses sign up. Turn off once your business exists if this server is only for you.
ALLOW_BUSINESS_SIGNUP=true

# Email: smtp, or log (development only: prints messages to the server log).
EMAIL_TRANSPORT=smtp
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
EMAIL_FROM=Workforce <no-reply@example.com>

# SMS: twilio, or log (development only).
SMS_TRANSPORT=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550000000

# Optional
SESSION_IDLE_DAYS=14
SESSION_ABSOLUTE_DAYS=60
INVITATION_DAYS=7
LOG_LEVEL=info
# Requests per client address per minute, per server (sign-in routes allow 60).
RATE_LIMIT_PER_MINUTE=600

# Private uploads (receipts, contracts). Must be on persistent storage and in
# your backups; never inside web/. Defaults to ./data/uploads.
UPLOAD_DIR=/var/lib/workforce/uploads
MAX_UPLOAD_MB=10

# Background jobs (email/SMS delivery, recurring expenses, alerts, exports).
# With several app servers, set this to true on exactly one of them.
RUN_JOBS=true

# docker compose only: password for the bundled PostgreSQL.
POSTGRES_PASSWORD=
