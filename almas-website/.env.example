# انسخ هذا الملف إلى .env وضع مفاتيح مشروع Supabase الخاص بك
# بدون هذه القيم يعمل الموقع في "الوضع التجريبي" (البيانات محفوظة في متصفحك فقط)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# رابط الموقع النهائي (لـ SEO والروابط الأساسية)
VITE_SITE_URL=https://almaas.iq
